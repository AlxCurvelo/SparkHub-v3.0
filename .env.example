# SparkHub v3.0 - Template de Ambiente
# RENOMEIE ESTE ARQUIVO PARA .env ANTES DE RODAR O SISTEMA, OU USE O SETUP SCRIPT

# ========================================================
# 1. API Keys (Modelos de IA e Integrações)
# ========================================================
# OpenRouter Free (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# ========================================================
# 2. Roteamento AI e Quad-Channel
# ========================================================
SOCIAL_AI_PROVIDER=OPENROUTER_FREE
MOLTBOOK_API_URL=http://localhost:8080/api/moltbook
SPARKHUB_PORT=8000
SPARKHUB_API_TOKEN=

# ========================================================
# 3. Contatos Base
# ========================================================
WHATSAPP_PHONE_NUMBER=5511999999999
